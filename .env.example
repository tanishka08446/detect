# === Hold On – Environment Variables ===

# DetectifAI Aletheia API key (REQUIRED)
DETECTIF_API_KEY=your_detectifai_api_key_here

# Speech-to-text (optional – app works without it, transcript will show "unavailable")
STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_MODEL=whisper-large-v3
STT_KEY=your_groq_api_key_here
# Telegram Guardian Alert (optional – alerts skipped if missing)
TG_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

# WhatsApp Cloud API Guardian Alert & Webhook (optional – alerts skipped if missing)
WA_TOKEN=your_whatsapp_cloud_api_token
WA_PHONE_NUMBER_ID= 
WA_TO=
WA_VERIFY_TOKEN=
# Server port
PORT=
